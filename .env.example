# Copiá este archivo a .env y completá los valores antes de arrancar el servidor.

PORT=3000

# Credenciales de Cloudinary (cloudinary.com, plan gratis) para las fotos que se suben
# desde el panel - se ven en el Dashboard al entrar. El disco de la app no sobrevive a
# un redeploy en Hostinger, así que las imágenes subidas necesitan vivir afuera.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contraseña del panel de administración (se usa solo la primera vez que arranca el
# servidor, para crear el usuario admin en la base de datos).
ADMIN_PASSWORD=cambiar-esta-clave

# Cadena secreta para firmar la cookie de sesión del panel. Poné cualquier texto largo
# y aleatorio, distinto en cada instalación.
SESSION_SECRET=cambiar-por-un-texto-largo-y-aleatorio

# Solo hace falta si el frontend (carpeta public/) se sirve desde un dominio DISTINTO al
# de este backend. Dejalo comentado/vacío si todo corre en el mismo dominio.
# CORS_ORIGIN=https://salonesleprett.com,https://www.salonesleprett.com

# Clave de recuperación de emergencia: si se pierde la contraseña del panel, desde
# "¿Olvidaste tu contraseña?" en /admin se puede resetear usando esta clave - la
# contraseña queda igual a lo que tenga ADMIN_PASSWORD en ese momento. Dejala sin definir
# para deshabilitar esta vía por completo.
# ADMIN_RECOVERY_KEY=
